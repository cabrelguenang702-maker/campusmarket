# Secrets à configurer sur le projet Supabase (Dashboard > Edge Functions > Secrets,
# ou `supabase secrets set NOM=valeur`). Ne jamais committer les vraies valeurs.

# --- Fournies automatiquement par Supabase à chaque Edge Function : ---
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY

# --- Compte marchand CamPay (sandbox puis prod) : ---
# À créer sur https://www.campay.net (ou l'environnement demo pour les tests :
# CAMPAY_BASE_URL=https://demo.campay.net). Identifiants trouvables dans
# Dashboard CamPay > Applications > votre app > "App Username" / "App Password".
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_BASE_URL=https://api.campay.net

# Clé webhook déclarée dans Dashboard CamPay > Applications > votre app >
# Webhook Key. Sert à vérifier la signature JWT du champ "signature" envoyé par CamPay
# (voir _shared/campay.ts, verifyWebhookSignature).
# OBLIGATOIRE : sans cette clé, payments-webhook refuse toute requête (503, fail-closed).
# Avec elle, une signature absente ou invalide est rejetée (401) avant toute écriture.
CAMPAY_WEBHOOK_KEY=

# Sandbox UNIQUEMENT : mettre "true" pour accepter des webhooks non signés (le temps de
# tester sans clé). Ne doit JAMAIS exister en production — le contrôle de pré-production
# (supabase/PRODUCTION.md) le rappelle.
# ALLOW_UNSIGNED_WEBHOOKS=true

# Origine EXACTE de l'application web (ex. https://campusmarket.example, sans slash final).
# Sans elle, les Edge Functions répondent "Access-Control-Allow-Origin: *" (développement).
ALLOWED_ORIGIN=

# Secret partagé arbitraire (générer avec `openssl rand -hex 32`), à fournir
# en Authorization: Bearer <valeur> par le job cron qui appelle
# payments-reconcile. Protège cet endpoint contre un appel public direct.
PAYMENTS_RECONCILE_SECRET=

# --- Vérification téléphone par OTP (phone-otp-request / phone-otp-verify) ---
# Aucun prestataire SMS choisi à ce stade. SMS_PROVIDER n'est qu'un nom
# indicatif ("twilio", "nexah", "nimbasms"...) : tant que _shared/sms.ts
# n'implémente pas l'appel réel pour ce nom, les fonctions échoueront
# explicitement (502 sms_provider_error) plutôt que d'échouer silencieusement.
SMS_PROVIDER=

# --- Notifications e-mail (notifications-dispatch) ---
# Secret partagé (openssl rand -hex 32) fourni en Authorization: Bearer par le cron.
NOTIFICATIONS_DISPATCH_SECRET=
# --- Prestataire e-mail (au choix) ---
# EMAIL_PROVIDER : "resend" | "brevo" | "mailgun". Formats de requête vérifiés dans
# la documentation de chacun ; testés contre un fetch simulé (pas d'envoi réel).
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Adresse d'expédition DÉJÀ VÉRIFIÉE chez le prestataire (domaine + DNS SPF/DKIM),
# ex. "CampusMarket <notifications@votre-domaine.com>". Cause n°1 d'échec au démarrage.
EMAIL_FROM=
# Mailgun uniquement :
MAILGUN_DOMAIN=
MAILGUN_REGION=us
